#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start MariaDB service
# ==============================================================================

declare has_extra_args

if bashio::config.has_value "mariadb_server_args"; then
  readarray -t extra_args <<< "$(bashio::config 'mariadb_server_args')"
fi

# Start mariadb
mkdir -p /run/mysqld
if ! [ -z "${extra_args+x}" ] && ! [ ${#extra_args[@]} -eq 0 ]; then
  has_extra_args="true"
fi
bashio::log.info "Starting MariaDB${has_extra_args:+ with command line parameters: ${extra_args[*]}}"
mariadbd --datadir="${MARIADB_DATA}" --user=root ${has_extra_args:+"${extra_args[@]}"} < /dev/null \
|& awk -F $'\n' -e '{ sub(/^[0-9]{4}-[0-9]{2}-[0-9]{2}\s{1,2}[0-9]{1,2}:[0-9]{2}:[0-9]{2} ([0-9]+ )?/, ""); print }'
