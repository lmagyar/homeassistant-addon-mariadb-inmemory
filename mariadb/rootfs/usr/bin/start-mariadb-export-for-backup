#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start maridb-export for backup
# ==============================================================================

# Redirect outputs to the log (&1 and &2 are not initialized by Docker)
exec &> /proc/1/fd/1
bashio::log.reinitialize_output

# Supervisor does not run the post backup command if this one fails
if ! s6-rc -v 2 -u change mariadb-export; then
    s6-rc -v 2 -d change mariadb-export || true
    exit 1
fi
